# Copy to .env and fill in. Nothing here is required for the headless synthetic run.

# Ledger. Defaults to a local SQLite file (data/ledger.sqlite) when unset.
# DATABASE_URL=postgresql+psycopg://mde:mde@localhost:5432/mde

# LLM interface (free text -> ProblemSpec, narrative, Q&A). Unset = headless only.
# ANTHROPIC_API_KEY=sk-ant-...
# MDE_LLM_MODEL=claude-opus-5

# Snowflake adapter (turns the demonstration into a finding). See docs/SNOWFLAKE.md.
# MDE_SNOWFLAKE_CONFIG=snowflake.yaml
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=

# Slack-compatible incoming webhook; every finished study posts a cited summary.
# MDE_WEBHOOK_URL=https://hooks.slack.com/services/...
# MDE_DASHBOARD_URL=https://decision-engine.internal.motorq.com

# LLM on Bedrock instead of the Anthropic API (AWS credentials from the task role)
# MDE_LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1

# LLM on Google Gemini (REST, no SDK). Free tier has a small per-model daily cap.
# MDE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# MDE_LLM_MODEL=gemini-3.6-flash

# Compute budget. Cross-validation folds run in parallel worker processes; threads x workers
# never exceeds MDE_CPUS. Set MDE_CPUS to the container's CPU limit (os.cpu_count() reports
# the host inside a container). MDE_FOLD_JOBS forces the worker count (1 = sequential).
# MDE_CPUS=4
# MDE_FOLD_JOBS=1

# Access. When set, every API route except /health requires `Authorization: Bearer <key>`.
# The dashboard reads the same variable server-side and adds the header in its proxy, so the
# key never reaches a browser. Unset = open, for local use only. MDE_CORS_ORIGINS narrows the
# browser origins the API answers (comma-separated; default any).
# MDE_API_KEY=change-me
# MDE_CORS_ORIGINS=https://decision-engine.internal.motorq.com

# Set MDE_LLM_PROVIDER=none to run with no language model at all (the engine and brief are
# complete without one; only free-text requests and the narrative/Q&A need it).
